    {
        "id": "sql_create",
        "type": "sqlite",
        "z": "flow_api",
        "mydb": "sqlitedb1",
        "sqlquery": "fixed",
        "sql": "CREATE TABLE IF NOT EXISTS sensor (id INTEGER PRIMARY KEY AUTOINCREMENT, suhu REAL, kelembaban REAL, timestamp TEXT, received TEXT);",
        "name": "Buat Tabel",
