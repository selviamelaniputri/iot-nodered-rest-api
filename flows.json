    {
        "id": "store_sensor",
        "type": "function",
        "z": "flow_api",
        "name": "Simpan Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\n\nvar threshold = flow.get('threshold');\ndata.threshold = (threshold === undefined) ? null : threshold;\ndata.alert = (threshold !== undefined && data.suhu > threshold);\n\nflow.set('lastSensor', data);\n\nif (data.alert) {\n    var notif = {\n        topic: 'iot/notifikasi',\n        payload: {\n            type: 'alert',\n            message: 'Suhu ' + data.suhu + '°C melewati batas ' + threshold + '°C',\n            suhu: data.suhu,\n            batas: threshold,\n            waktu: data.received\n        }\n    };\n    return [msg, notif];\n}\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 100,
        "wires": [
            [
                "debug_sensor",
                "fn_insert",
                "ws_out"
            ],
            [
                "mqtt_notif",
                "debug_notif"
            ]
        ]
    },
