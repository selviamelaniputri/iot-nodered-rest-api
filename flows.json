    {
        "id": "proc_threshold",
        "type": "function",
        "z": "flow_api",
        "name": "Set Threshold",
        "func": "if (msg.req.headers['x-api-key'] !== 'GANTI_DENGAN_API_KEY') {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\n\nvar batas = Number(msg.payload && msg.payload.batas_suhu);\nif (!msg.payload || msg.payload.batas_suhu === undefined || isNaN(batas)) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'batas_suhu wajib berupa angka'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\n\nflow.set('threshold', batas);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Threshold diperbarui', batas_suhu: batas};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
