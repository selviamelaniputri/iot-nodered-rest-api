    {
        "id": "fn_insert",
        "type": "function",
        "z": "flow_api",
        "name": "Siapkan INSERT",
        "func": "var d = msg.payload;\nmsg.params = {\n    $suhu: d.suhu,\n    $kelembaban: d.kelembaban,\n    $timestamp: d.timestamp,\n    $received: d.received\n};\nreturn msg;",
