    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "flow_api",
        "name": "Validasi & Publish",
        "func": "if (msg.req.headers['x-api-key'] !== 'GANTI_DENGAN_API_KEY') {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'API key tidak valid' };\n    msg.headers = { 'Access-Control-Allow-Origin': '*' };\n    return [msg, null];\n}\n\nvar body = msg.payload;\nif (!body || !body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'device dan action wajib diisi' };\n    msg.headers = { 'Access-Control-Allow-Origin': '*' };\n    return [msg, null];\n}\n\nvar mqttMsg = { payload: body, topic: 'iot/kontrol' };\n\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', message: 'Perintah terkirim', sent: body };\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\nreturn [msg, mqttMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 360,
        "wires": [
